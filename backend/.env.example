NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://kms_app:password@127.0.0.1:5432/kms_project
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY_HOPS=0
# Production wajib memakai path absolut di luar source code, misalnya /var/lib/kms/uploads.
UPLOAD_DIR=
# Development dapat true. Production harus false agar file hanya disajikan Nginx.
SERVE_UPLOADS_FROM_API=true
# Kosongkan di development. Produksi dapat memakai /_kms_uploads bersama X-Accel-Redirect Nginx.
MEDIA_ACCEL_REDIRECT_PREFIX=
# Produksi: false agar log request dan migrasi tidak membebani setiap startup.
HTTP_LOGGING=true
RUN_MIGRATIONS_ON_START=true
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=30000
REQUEST_BODY_LIMIT_KB=1024
SERVER_KEEP_ALIVE_TIMEOUT_MS=65000
SERVER_HEADERS_TIMEOUT_MS=66000
SERVER_REQUEST_TIMEOUT_MS=120000
SERVER_SHUTDOWN_TIMEOUT_MS=10000
ASSET_UPLOAD_MAX_BYTES=20971520
AVATAR_UPLOAD_MAX_BYTES=2097152
UPLOAD_MINIMUM_FREE_BYTES=104857600
MEDIA_OPTIMIZATION_ENABLED=false
FFMPEG_PATH=ffmpeg
GHOSTSCRIPT_PATH=gs
MEDIA_OPTIMIZATION_TIMEOUT_MS=90000
MEDIA_OPTIMIZATION_CONCURRENCY=1
MEDIA_OPTIMIZATION_VIDEO_CRF=28
MEDIA_OPTIMIZATION_PDF_QUALITY=ebook
MEDIA_OPTIMIZATION_MIN_SAVINGS_PERCENT=5
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_WRITE_MAX=120
RATE_LIMIT_PUBLIC_EVENT_MAX=60
SESSION_COOKIE_SECURE=false
CSRF_SECRET=ganti-dengan-rahasia-acak-minimal-32-karakter
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_MINUTES=480
ADMIN_SESSION_IDLE_MINUTES=20
ADMIN_SESSION_ABSOLUTE_MINUTES=120
SESSION_TOUCH_INTERVAL_SECONDS=300
ADMIN_EMAIL=admin@kemenhub.go.id
# Generate once with bcrypt.hash('password-yang-kuat', 10); jangan simpan password teks biasa.
ADMIN_PASSWORD_HASH=$2b$10$ganti.dengan.hash.bcrypt.admin
ADMIN_FULL_NAME=Administrator KMS Kemenhub
