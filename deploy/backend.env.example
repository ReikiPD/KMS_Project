NODE_ENV=production
HOST=127.0.0.1
PORT=3000
FRONTEND_ORIGIN=https://__SERVER_NAME__
TRUST_PROXY_HOPS=1

DATABASE_URL=postgresql://kms_app:__URL_ENCODED_PASSWORD__@127.0.0.1:5432/kms_project
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=30000

UPLOAD_DIR=/var/lib/kms/uploads
SERVE_UPLOADS_FROM_API=false
# Opsional tetapi direkomendasikan di produksi. Harus cocok dengan location internal Nginx.
MEDIA_ACCEL_REDIRECT_PREFIX=/_kms_uploads
ASSET_UPLOAD_MAX_BYTES=20971520
AVATAR_UPLOAD_MAX_BYTES=2097152
UPLOAD_MINIMUM_FREE_BYTES=2147483648
MEDIA_OPTIMIZATION_ENABLED=true
FFMPEG_PATH=/usr/bin/ffmpeg
GHOSTSCRIPT_PATH=/usr/bin/gs
MEDIA_OPTIMIZATION_TIMEOUT_MS=90000
MEDIA_OPTIMIZATION_CONCURRENCY=1
MEDIA_OPTIMIZATION_VIDEO_CRF=28
MEDIA_OPTIMIZATION_PDF_QUALITY=ebook
MEDIA_OPTIMIZATION_MIN_SAVINGS_PERCENT=5
REQUEST_BODY_LIMIT_KB=1024
SERVER_KEEP_ALIVE_TIMEOUT_MS=65000
SERVER_HEADERS_TIMEOUT_MS=66000
SERVER_REQUEST_TIMEOUT_MS=120000
SERVER_SHUTDOWN_TIMEOUT_MS=10000

SESSION_COOKIE_SECURE=true
CSRF_SECRET=__RANDOM_SECRET_MINIMUM_48_CHARACTERS__
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_MINUTES=480
ADMIN_SESSION_IDLE_MINUTES=20
ADMIN_SESSION_ABSOLUTE_MINUTES=120
SESSION_TOUCH_INTERVAL_SECONDS=300

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_WRITE_MAX=120
RATE_LIMIT_PUBLIC_EVENT_MAX=60

KMS_ADMIN_EMAIL=admin@kemenhub.go.id
KMS_ADMIN_PASSWORD_HASH=__BCRYPT_HASH_ONLY__
KMS_ADMIN_FULL_NAME=Administrator KMS Kemenhub

RUN_MIGRATIONS_ON_START=false
HTTP_LOGGING=false
