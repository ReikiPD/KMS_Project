[Unit]
Description=KMS Kemenhub Backend API
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/var/lib/kms/uploads

[Service]
Type=simple
User=kms
Group=kms-app
SupplementaryGroups=kms-files
WorkingDirectory=/opt/kms/current/backend
EnvironmentFile=/etc/kms/backend.env
Environment=NODE_OPTIONS=--max-old-space-size=1024
ExecStart=/usr/bin/node app.js
ExecStartPost=/usr/local/sbin/kms-wait-ready
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
KillSignal=SIGTERM
UMask=0027
TasksMax=128
LimitNOFILE=4096
MemoryHigh=1G
MemoryMax=1536M

# Backend hanya membutuhkan akses tulis ke penyimpanan media.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
ReadWritePaths=/var/lib/kms/uploads

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
